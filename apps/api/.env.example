NODE_ENV=development
HOST=127.0.0.1
PORT=3001
DATABASE_URL=postgresql://auralis:auralis_local_only@localhost:5432/auralis
# Supply a random persistent key of at least 32 characters; never commit it.
# In development only, an unset key is generated in memory on each API restart.
# JWT_SECRET=
WEB_ORIGIN=http://localhost:5174
LAUNCHER_ORIGIN=http://localhost:5173
DEV_MAILBOX=true
TRUST_PROXY=false
# To deliver actual email instead of the loopback-only development mailbox:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Auralis <noreply@example.com>
# TEST_DATABASE_URL=postgresql://auralis:auralis_local_only@localhost:5432/auralis_test
