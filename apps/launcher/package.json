{
  "name": "@auralis/launcher",
  "productName": "Auralis",
  "version": "0.1.3",
  "description": "Auralis — ваш мир начинается здесь. Minecraft Java launcher.",
  "author": "Auralis Contributors",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "corepack pnpm build:electron && concurrently --kill-others \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env AURALIS_DEV_URL=http://127.0.0.1:5173 electron .\"",
    "dev:web": "vite --host 0.0.0.0",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "corepack pnpm typecheck && vite build && corepack pnpm build:electron",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run electron/*.test.ts",
    "pack": "corepack pnpm build && electron-builder --dir --publish never",
    "dist:win": "corepack pnpm build && electron-builder --win nsis --x64 --publish never",
    "dist:mac": "corepack pnpm build && node ../../scripts/package-mac.mjs"
  },
  "dependencies": {
    "@auralis/shared": "workspace:*",
    "@xmcl/core": "2.15.1",
    "@xmcl/installer": "6.1.2",
    "electron-updater": "6.8.3",
    "framer-motion": "^12.0.0",
    "lucide-react": "^0.468.0",
    "prismarine-auth": "3.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "undici": "^7.29.0",
    "zod": "^3.24.0",
    "@xmcl/file-transfer": "2.0.3",
    "@xmcl/task": "4.1.1"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.2.0",
    "cross-env": "^7.0.3",
    "electron": "45.1.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.0",
    "wait-on": "^8.0.3"
  }
}
