# Local development only. Copy to .env and create apps/api/.env from its example.
POSTGRES_USER=auralis
POSTGRES_PASSWORD=auralis_local_only
POSTGRES_DB=auralis
DATABASE_URL=postgresql://auralis:auralis_local_only@localhost:5432/auralis?schema=public
# Generate a separate production secret with: openssl rand -hex 32
JWT_SECRET=replace_with_at_least_32_random_characters
PORT=3001
WEB_ORIGIN=http://localhost:5174
VITE_API_URL=http://localhost:3001/api
