{
    email {$CADDY_EMAIL}
}

{$APP_DOMAIN} {
    encode zstd gzip
    request_body {
        max_size 2MB
    }
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-Frame-Options "DENY"
    }
    handle /api/* {
        reverse_proxy api:3001
    }
    handle {
        reverse_proxy web:80
    }
}
